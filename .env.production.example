# Copy to .env.production and fill EVERY value. Never commit the real file. Generate secrets with:  openssl rand -base64 48
DOMAIN=guruku.example.com
APP_ENV=production
APP_BASE_URL=https://guruku.example.com
SECRET_KEY=
PROVIDER_KEY_MASTER=            # encrypts provider API keys + MFA secrets. LOSING THIS MEANS RE-ENTERING THEM. Back it up separately.

POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://app:CHANGE_ME@db:5432/app   # same password as POSTGRES_PASSWORD
REDIS_PASSWORD=
REDIS_URL=redis://:CHANGE_ME@redis:6379/0                      # same password as REDIS_PASSWORD
QUEUE_MODE=celery

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@guruku.example.com

PAYMENT_GATEWAY=midtrans        # midtrans | xendit  (NOT fake)
MIDTRANS_SERVER_KEY=
MIDTRANS_PRODUCTION=false       # true only with live keys, after sandbox testing
XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=

ADMIN_MFA_REQUIRED=true
SENTRY_DSN=                     # optional error monitoring

# Object storage for library files (S3-compatible: AWS S3, Cloudflare R2, MinIO...). Leave blank to store on the server's disk volume.
STORAGE_BACKEND=local           # local | s3
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Backups
BACKUP_PASSPHRASE=              # encrypts dumps; store it somewhere other than this server
BACKUP_KEEP_DAYS=14
BACKUP_S3_URI=                  # optional, e.g. s3://my-bucket/guruku-backups  (needs awscli credentials)
